{
  "name": "@tested/mcp",
  "version": "0.1.1",
  "description": "MCP server exposing tested coverage tools over stdio for Claude Code / Cursor / Claude API.",
  "license": "MIT",
  "homepage": "https://tested.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tested-hq/mcp.git"
  },
  "bugs": {
    "url": "https://github.com/tested-hq/mcp/issues"
  },
  "type": "module",
  "packageManager": "pnpm@11.3.0",
  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "tested-mcp": "./dist/tested-mcp.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsx bin/tested-mcp.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.29.0",
    "@tested/cli": "^0.1.5",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "25.9.1",
    "@vitest/coverage-v8": "4.1.7",
    "tsup": "8.5.1",
    "tsx": "4.22.3",
    "typescript": "6.0.3",
    "vite": "8.0.14",
    "vitest": "4.1.7"
  }
}
