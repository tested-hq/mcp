{
  "name": "@tested/mcp",
  "version": "0.0.1",
  "description": "MCP server exposing tested coverage tools over stdio for Claude Code / Cursor / Claude API.",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.0",
  "bin": {
    "tested-mcp": "./dist/tested-mcp.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsx bin/tested-mcp.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.29.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "22.10.2",
    "@vitest/coverage-v8": "2.1.8",
    "tsup": "8.3.5",
    "tsx": "4.19.2",
    "typescript": "5.7.2",
    "vitest": "2.1.8"
  }
}
